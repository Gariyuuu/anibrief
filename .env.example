# Copy to .env.local for local dev. Add each variable to Vercel
# (Project Settings -> Environment Variables) for production.
# Never commit .env.local — it is already in .gitignore.

# --- Clerk (authentication) ---
# `clerk init --framework next` (see clerk-setup skill / clerk.com CLI docs) provisions
# a dev app and writes these automatically. Get production keys from https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Neon Postgres (database, via Drizzle) ---
# Create a project at https://neon.tech (or, if this app is deployed on Vercel, add
# "Postgres (powered by Neon)" from the project's Storage tab, which writes this for you).
# Without this set, the app still runs — every personalization feature (lists, favorites,
# alerts, briefing archive) degrades to a clear "sign in" / "not configured" state instead
# of crashing, and the daily briefing archive falls back to in-memory (non-persistent).
DATABASE_URL=

# Admin dashboard access: comma-separated list of Clerk user IDs (starts with "user_") that
# may access /admin, in addition to any profile with isAdmin=true in the database.
ADMIN_USER_IDS=

# --- AniList (primary anime/manga/people/airing data source) ---
# No key required — https://graphql.anilist.co is a public, unauthenticated GraphQL API.

# --- MyAnimeList official API (optional, supplementary — ranking data, list sync) ---
# Register a client at https://myanimelist.net/apiconfig to enable. Left unset, the
# MyAnimeListProvider degrades to a documented no-op; AniList already covers rankings.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# --- YouTube Data API (optional — trailer/PV search) ---
# https://console.cloud.google.com -> enable "YouTube Data API v3" -> create an API key.
# Left unset, trailer search returns empty results with a clear "not configured" state.
YOUTUBE_API_KEY=

# --- AI summarization provider (optional — daily brief executive summary) ---
# Set AI_PROVIDER to "anthropic" or "openai"; only that provider's key is required.
# Left unset entirely, the daily brief falls back to a deterministic, fact-only template
# summary (no AI call at all) — see src/lib/briefing/buildBriefing.ts.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# --- Protects scheduled ingestion/refresh routes (src/app/api/cron/*) from being
# triggered by outsiders. Any random string; Vercel Cron sends it automatically as a
# Bearer token once set. Left unset, cron routes still run (for local testing) but log
# a warning. ---
CRON_SECRET=

# --- Used to build absolute links (share URLs, email links, Open Graph metadata). ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Not yet wired up in this deployment (dependency present, no call sites) ---
# Reserved for a future email-digest feature (spec §21/§8's "Email" delivery option is
# currently served by a client-side mailto: link instead, which needs no key).
RESEND_API_KEY=
RESEND_FROM_EMAIL="AniBrief <brief@yourdomain.com>"
